# =============================================================================
# Hybrid GraphRAG Enterprise Knowledge Assistant
# Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to .env:  cp .env.example .env
#   2. Fill in all required values below.
#   3. NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=
APP_ENV=
APP_VERSION=
DEBUG=
LOG_LEVEL=
SECRET_KEY=
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Backend Server
# -----------------------------------------------------------------------------
BACKEND_HOST=
BACKEND_PORT=

# -----------------------------------------------------------------------------
# Supabase PostgreSQL Database
# -----------------------------------------------------------------------------
# Replace with Supabase Session Pooler or Direct Connection URL
# Format:
# postgresql://user:password@host:port/database

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:PORT/postgres

# -----------------------------------------------------------------------------
# MinIO Object Storage
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# Qdrant Vector Database
# -----------------------------------------------------------------------------
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# -----------------------------------------------------------------------------
# Neo4j Knowledge Graph
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_secure_password
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# Hybrid Retrieval Engine
# -----------------------------------------------------------------------------
VECTOR_WEIGHT=0.7
GRAPH_WEIGHT=0.3
MAX_CONTEXT_TOKENS=4000

# LLM Provider Configuration (openai, gemini, azure, ollama)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# API Keys (set only what you use)
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
GROQ_API_KEY=
# Additional Groq API keys for automatic rotation when rate limits are reached
# The system will automatically switch to backup keys when the primary key hits rate limits
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
LLM_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=

# -----------------------------------------------------------------------------
# Audio Configuration (STT / TTS)
# -----------------------------------------------------------------------------
STT_MODEL=whisper-large-v3
TTS_MODEL_EN=canopylabs/orpheus-v1-english
TTS_MODEL_AR=canopylabs/orpheus-arabic-saudi
OPENAI_API_KEY=
OPENAI_BASE_URL=
EXTRACTION_MODEL=

# -----------------------------------------------------------------------------
# Embeddings Configuration
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_MAX_LENGTH=8192
EMBEDDING_BATCH_SIZE=16
EMBEDDING_USE_FP16=false

# -----------------------------------------------------------------------------
# Document Chunking (AI Pipeline)
# -----------------------------------------------------------------------------
# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CHUNK_SIZE=100
MAX_CHUNK_SIZE=2000

# -----------------------------------------------------------------------------
# Supabase Authentication
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
